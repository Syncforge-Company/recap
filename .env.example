# ─────────────────────────────────────────────────────────────────────────────
# Recap (SyncForge) — fork do OpenRecapper. Copie para `.env` e preencha.
# Com docker compose, este mesmo arquivo alimenta o bot e o relay.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord (obrigatório) ────────────────────────────────────────────────────
# Developer Portal (veja DISCORD_SETUP.md).
DISCORD_TOKEN=your-bot-token
# Vários tokens = várias gravações simultâneas no mesmo servidor (primário primeiro).
# DISCORD_TOKENS=primary-token,recorder2-token
DISCORD_CLIENT_ID=your-application-id

# ── Transcrição ──────────────────────────────────────────────────────────────
# "groq" (Whisper no Groq, plano gratuito) ou "deepgram".
TRANSCRIPTION_PROVIDER=groq
# https://console.groq.com/keys — usado pelo bot (Whisper) e, se LLM_PROVIDER=groq, pelo relay.
GROQ_API_KEY=your-groq-api-key
# whisper-large-v3 (mais preciso) ou whisper-large-v3-turbo (mais rápido)
GROQ_WHISPER_MODEL=whisper-large-v3
TRANSCRIPTION_LANGUAGE=pt
# Glossário opcional para o Whisper (termos técnicos, nomes incomuns). Deixe vazio
# se aparecerem na transcrição frases que ninguém disse: em áudio com ruído o
# Whisper às vezes "lê" este texto de volta.
GROQ_WHISPER_PROMPT=
# WHISPER_PROMPT_NAMES=false   # incluir os nomes dos participantes no glossário
# Ritmo do envio (um pouco abaixo do plano gratuito do Groq). Confira os
# limites da sua conta em https://console.groq.com/settings/limits
# GROQ_AUDIO_SECONDS_PER_HOUR=7000
# GROQ_AUDIO_SECONDS_PER_DAY=28000
# GROQ_REQUESTS_PER_MINUTE=18
# Detector de silêncio: quadros abaixo deste volume (dBFS) são descartados.
# Aumente (ex.: -40) se ruído de fundo estiver sendo enviado; diminua (ex.: -50) se cortar fala baixa.
# VAD_THRESHOLD_DBFS=-45
# TRANSCRIPTION_CHUNK_SECONDS=600
# Deepgram (opcional): só necessário com TRANSCRIPTION_PROVIDER=deepgram ou para
# a transcrição ao vivo no canal durante a chamada.
# DEEPGRAM_API_KEY=
# LIVE_TRANSCRIPTION=true   # só funciona com DEEPGRAM_API_KEY válida

# ── Geral ────────────────────────────────────────────────────────────────────
BOT_NAME=Recap
# Opções do /record (a data é adicionada automaticamente). Nomes com
# "Presencial" avisam a ata de que foi um microfone só para a sala toda.
RECORD_MEETING_NAMES=SyncForge - Geral,SyncForge - SIGEM,SyncForge - Marketing,SyncForge - Planejamento,SyncForge - Presencial,Cliente
# Fuso usado nas datas dos nomes de reunião e no /schedule.
SCHEDULED_TIMEZONE=America/Manaus
# RECORDINGS_DIR=/var/lib/recap/recordings
# ID do Discord de quem recebe DM se o health check falhar.
# ALERT_DISCORD_USER_ID=
# Dias até apagar os áudios brutos (transcrições e atas ficam).
# RECORDING_RETENTION_DAYS=7

# ── Reuniões presenciais ─────────────────────────────────────────────────────
# IDs dos canais de texto onde um áudio enviado (ou link direto) vira ata.
# Botão direito no canal > Copiar ID (ative o Modo Desenvolvedor no Discord).
IN_PERSON_CHANNEL_IDS=
# IN_PERSON_MAX_MB=200

# ── Ata e e-mail ─────────────────────────────────────────────────────────────
# "ata-pt" (ata em português) ou "study-group" (template original em inglês).
SUMMARY_TEMPLATE=ata-pt
# Contexto da equipe para a ata (use \n para quebrar linha).
SUMMARY_CONTEXT=Empresa: SyncForge, software house de Manaus. Produto principal: SIGEM (ERP SaaS modular).\nEquipe: Davi Peterson (CEO, tech lead e desenvolvedor), Alessandra (sócia, marketing, análise, testes, Instagram e Facebook), William (front-end), Evelyn (front-end e back-end, foco em segurança).
# Para onde vai a ata depois de cada reunião.
SUMMARY_EMAIL_TO=contato.syncforge@gmail.com
# Assunto do e-mail. A automação semanal procura por "[REUNIÃO]".
EMAIL_SUBJECT_TEMPLATE=[REUNIÃO] {callName}
# Anexar a transcrição inteira ao e-mail (deixa o e-mail longo).
EMAIL_INCLUDE_TRANSCRIPT=false

# ── Relay (resumo por IA + envio de e-mail) ──────────────────────────────────
# Segredo compartilhado entre bot e relay: gere com `openssl rand -hex 24`.
RELAY_TOKEN=change-me
# Com docker compose o RELAY_URL é definido automaticamente (http://relay:8787).
# RELAY_URL=http://127.0.0.1:8787
# Provedor do resumo: groq | openrouter | gemini | anthropic | openai-compatible
LLM_PROVIDER=groq
# LLM_MODEL=                 # vazio = padrão do provedor (groq: openai/gpt-oss-120b)
# LLM_REASONING_EFFORT=medium   # low | medium | high (modelos gpt-oss)
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=         # com LLM_PROVIDER=anthropic (padrão: claude-haiku-5-5)
# LLM_BASE_URL= / LLM_API_KEY=   # para openai-compatible
# LLM_MAX_TOKENS=6000
# E-mail (Gmail: ative a verificação em 2 etapas e crie uma "senha de app").
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contato.syncforge@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Recap SyncForge <contato.syncforge@gmail.com>

# ── GitHub issue filing via /openrecapper-issue (optional) ───────────────────
# Users describe a bug/feature in plain text; the relay LLM drafts a title +
# description and the bot files it directly on GitHub. Needs all three below.
# Use a fine-grained PAT scoped to "Issues: Read & Write" on just the one repo.
# GITHUB_TOKEN=github_pat_...
# GITHUB_OWNER=your-org-or-user
# GITHUB_REPO=your-repo
# Comma-separated recipients emailed when an issue is filed (needs the relay).
# Standalone — if unset, no issue emails are sent (no fallback to SUMMARY_EMAIL_TO).
# ISSUE_EMAIL_TO=you@example.com
# Discord user IDs (comma-separated) to cc/@-mention at the end of the public
# reply when an issue is filed. Empty = no cc line.
# ISSUE_CC_USER_IDS=111111111111111111,222222222222222222

# ── Cloud archival to S3-compatible storage (optional, e.g. Cloudflare R2) ────
# If these are unset, recordings/transcripts stay on local disk only. Upload is
# enabled when ACCESS_KEY_ID + SECRET_ACCESS_KEY + ENDPOINT are all present.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=your-bucket-name
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://your-public-bucket-url

# ── Scheduled recording ──────────────────────────────────────────────────────
# Standing-call schedules are now managed at runtime via the `/schedule` slash
# command (ManageGuild) and persisted to data/schedules.json. You normally do
# NOT need any env vars here.
#
# Optional: override where schedules are stored.
# SCHEDULES_FILE=/var/lib/openrecapper/schedules.json
#
# ── Legacy one-time seed (optional) ──────────────────────────────────────────
# These SCHEDULED_* vars are ONLY read once, to seed the first schedule the very
# first time the bot starts WITHOUT a data/schedules.json file. After that file
# exists they are ignored entirely — the JSON store is the source of truth.
# SCHEDULED_GUILD_ID=
# SCHEDULED_VOICE_CHANNEL_ID=
# SCHEDULED_TEXT_CHANNEL_ID=
# SCHEDULED_CRON=15 11 * * 1,5
# SCHEDULED_TIMEZONE=America/New_York
# SCHEDULED_NAME=Standing call
